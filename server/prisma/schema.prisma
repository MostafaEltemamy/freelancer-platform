generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  displayName     String?   @map("display_name") @db.VarChar(120)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential PasswordCredential?
  sessions           Session[]
  freelancerProfile  FreelancerProfile?

  @@map("users")
}

model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
}

model FreelancerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Public identity
  username String? @unique @db.VarChar(30)
  headline String? @db.VarChar(160)
  bio      String? @db.Text

  // Professional location
  city        String? @db.VarChar(100)
  countryCode String? @map("country_code") @db.VarChar(2)

  // External website
  websiteUrl String? @map("website_url") @db.VarChar(2048)

  // Onboarding and publication
  status                ProfileStatus @default(DRAFT)
  onboardingCompletedAt DateTime?     @map("onboarding_completed_at") @db.Timestamptz(3)
  publishedAt           DateTime?     @map("published_at") @db.Timestamptz(3)

  // Audit timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Ownership
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Portfolio and professional skills
  projects PortfolioProject[]
  skills   ProfileSkill[]

  @@index([status, publishedAt])
  @@map("freelancer_profiles")
}

enum PortfolioProjectVisibility {
  PRIVATE
  PUBLIC
}

model PortfolioProject {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  // Project identity
  slug        String  @db.VarChar(80)
  title       String  @db.VarChar(160)
  summary     String? @db.VarChar(500)
  description String? @db.Text
  role        String? @db.VarChar(120)

  // External links
  projectUrl String? @map("project_url") @db.VarChar(2048)
  sourceUrl  String? @map("source_url") @db.VarChar(2048)

  // Project-specific technology stack
  technologies String[] @default([])

  // Optional project dates
  startedOn DateTime? @map("started_on") @db.Date
  endedOn   DateTime? @map("ended_on") @db.Date

  // Publication and presentation
  visibility PortfolioProjectVisibility @default(PRIVATE)
  sortOrder  Int                        @default(0) @map("sort_order")
  isFeatured Boolean                    @default(false) @map("is_featured")

  // Freelancer-defined project sections and fields.
  // Null preserves compatibility with existing projects.
  content Json? @db.JsonB

  // Optimistic concurrency control
  version Int @default(1)

  // Audit timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Ownership
  profile FreelancerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Images, videos and documents belonging to this project.
  media ProjectMedia[]

  @@unique([profileId, slug])
  @@index([profileId, visibility, sortOrder])
  @@map("portfolio_projects")
}

model ProfileSkill {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  // Display name and uniqueness key
  name           String @db.VarChar(80)
  normalizedName String @map("normalized_name") @db.VarChar(80)

  // User-defined display order
  sortOrder Int @default(0) @map("sort_order")

  // Optimistic concurrency control
  version Int @default(1)

  // Audit timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Ownership
  profile FreelancerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalizedName])
  @@index([profileId, sortOrder])
  @@map("profile_skills")
}

enum ProjectMediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ProjectMediaStatus {
  PENDING
  READY
  FAILED
}

model ProjectMedia {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // Server-generated object-storage references.
  // Never accept a storage key directly from the client.
  storageKey String  @unique @map("storage_key") @db.VarChar(512)
  previewKey String? @unique @map("preview_key") @db.VarChar(512)

  // Original file metadata.
  originalFilename String @map("original_filename") @db.VarChar(255)
  mimeType         String @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int    @map("file_size_bytes")

  // Classified by the backend.
  kind   ProjectMediaKind
  status ProjectMediaStatus @default(PENDING)

  // Exactly one image can be the project cover.
  isCover Boolean @default(false) @map("is_cover")

  // Order inside the media gallery.
  sortOrder Int @default(0) @map("sort_order")

  // Optional association with a custom project section.
  sectionId String? @map("section_id") @db.Uuid

  // Image and video metadata populated after processing.
  width  Int?
  height Int?

  // Display and accessibility metadata.
  altText String? @map("alt_text") @db.VarChar(200)
  caption String? @db.VarChar(500)

  // Concurrency and audit information.
  version Int @default(1)

  readyAt   DateTime? @map("ready_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Deleting a project also removes its metadata records.
  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Database-level guarantee: at most one cover per project.
  @@unique([projectId], map: "project_media_unique_cover", where: { isCover: true })
  @@index([projectId, status, sortOrder])
  @@index([projectId, sectionId, sortOrder])
  @@map("project_media")
}
